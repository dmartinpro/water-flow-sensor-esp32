# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml should NOT be committed to version control.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for the fallback WiFi hotspot the device creates if it can't
# reach your WiFi network. Must be at least 8 characters.
ap_fallback_password: "CHOOSE_A_STRONG_PASSWORD"

mqtt_broker: "192.168.1.10"
mqtt_username: "mqtt_user"
mqtt_password: "mqtt_password"

# Generate with: openssl rand -base64 32
api_encryption_key: "GENERATE_ME_SEE_README"

# Any password of your choosing, used to authorize OTA firmware updates.
ota_password: "CHOOSE_A_STRONG_PASSWORD"
